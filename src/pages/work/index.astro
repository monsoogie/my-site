---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Scribble from '../../components/Scribble.astro';
import { projects } from '../../data/projects';
---
<Base title="Work" description="Selected branding, UX/UI, web and leadership work.">
  <section class="head container">
    <Scribble variant={2} style="right:-4%; top:-30px; width:min(40%, 480px);" />
    <p class="caps">Work</p>
    <h1 class="stack">Brand systems. <em>Product flows.</em> Sites that move.</h1>
    <p class="lede soft">A few projects from the last few years. Each one was made with a small team, and each case study says who did what.</p>
  </section>

  <section class="container" aria-label="All projects">
    <ul class="grid">
      {projects.map((p) => <li><ProjectCard project={p} headingLevel="h2" /></li>)}
    </ul>
  </section>
</Base>

<style>
  .head { position: relative; display: grid; gap: 20px; padding-block: clamp(40px, 7vw, 96px) clamp(40px, 5vw, 64px); }
  .head > :not(.scribble) { position: relative; z-index: 1; }
  h1 { font-size: clamp(44px, 7vw, 104px); max-width: 12ch; }
  .grid { list-style: none; margin: 0; padding: 0 0 clamp(48px, 8vw, 96px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .grid li { display: grid; }
</style>
